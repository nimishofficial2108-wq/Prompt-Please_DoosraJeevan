# Copy to .env at project root. These settings are for local demos with synthetic data only.
API_PORT=3001
XAI_API_KEY=
XAI_MODEL=grok-4.7
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
ALLOW_DEMO_REPORTS=false
# Organ agent keys are also loaded by its own server from root .env
MISTRAL_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
DEFAULT_HOSPITAL_EMAIL=
ENABLE_EXTERNAL_NOTIFICATIONS=false
# Neuro server loads the same root .env
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local Hardhat blockchain runs on 127.0.0.1:8545 (chain ID 31337).
# Development uses pre-funded accounts from a disposable local Hardhat node.
BLOCKCHAIN_MODE=local
BLOCKCHAIN_PORT=4000
LOCAL_RPC_URL=http://127.0.0.1:8545
HASH_SALT=replace-with-random-development-only-value
# Optional Polygon Amoy only if separately configured and deployed; not active by default.
AMOY_RPC_URL=
PRIVATE_KEY=
LEDGER_CONTRACT_ADDRESS=
PATIENT_NFT_CONTRACT_ADDRESS=
