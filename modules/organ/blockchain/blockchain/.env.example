# Get a free RPC URL from Alchemy or use the public one below
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Your MetaMask wallet's private key (use a NEW wallet, only for testnet - never your real one)
PRIVATE_KEY=

# Filled in automatically by scripts/deploy.js after you deploy
LEDGER_CONTRACT_ADDRESS=
PATIENT_NFT_CONTRACT_ADDRESS=

# Random secret string used to hash Aadhaar/UID before it ever touches the chain
HASH_SALT=change_this_to_a_random_string

PORT=4000
